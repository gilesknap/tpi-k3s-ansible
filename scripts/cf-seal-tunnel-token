#!/usr/bin/env bash
# Seal the cloudflared tunnel token from the OpenTofu state into
# kubernetes-services/additions/cloudflared/tunnel-secret.yaml, without
# printing it. Run after `just cf-apply` has set a new tunnel secret; see
# "Rotate the tunnel token" in docs/how-to/cloudflare-as-code.md.
#
# If .env at the repo root (written by scripts/export-external-creds for a
# rebuild) has a CLOUDFLARE_TUNNEL_TOKEN line, it is updated too, so that
# a rebuild from that .env does not reseal the old token.
#
# --env-only (just cf-env-tunnel-token): skip the sealing, which needs a
# running cluster, and only add or update the CLOUDFLARE_TUNNEL_TOKEN line
# in .env (created mode 600 if missing). For a first build, after
# `just cf-apply` has created the tunnel and before the GENERATE_SECRETS
# run, whose cluster stage needs the token.
set -euo pipefail

env_only=false
case ${1:-} in
    --env-only) env_only=true ;;
    "") ;;
    *) echo "usage: $0 [--env-only]" >&2; exit 2 ;;
esac

cd "$(dirname "$0")/.."
. scripts/lib/seal.sh

dest=kubernetes-services/additions/cloudflared/tunnel-secret.yaml

# Reads only the local, encrypted state (state passphrase, no API token).
if ! token=$(scripts/cf-tofu output -raw tunnel_token); then
    echo "ERROR: could not read the tunnel_token output; has 'just cf-apply' run since tunnel.tf gained it?" >&2
    exit 1
fi
if [[ -z $token ]]; then
    echo "ERROR: the tunnel_token output is empty; has 'just cf-apply' run?" >&2
    exit 1
fi
# A tunnel token is base64 of JSON with the account (a), secret (s) and
# tunnel ID (t). Check the shape without showing any of it.
if ! printf '%s' "$token" | base64 -d 2>/dev/null |
    jq -e '(.a | type) == "string" and (.a | length) > 0
        and (.s | type) == "string" and (.s | length) > 0
        and (.t | type) == "string" and (.t | length) > 0' >/dev/null 2>&1; then
    echo "ERROR: the tunnel_token output is not a tunnel token" >&2
    exit 1
fi

if ! $env_only; then
    echo "Sealing: cloudflared-credentials..."
    printf '%s' "$token" |
        kubectl create secret generic cloudflared-credentials --namespace=cloudflared \
            --from-file=TUNNEL_TOKEN=/dev/stdin \
            --dry-run=client -o yaml | seal_to "$dest"
    echo "  -> $dest"
fi

# Without --env-only, .env is only updated if it already carries the line.
if $env_only || { [[ -f .env ]] && grep -q '^CLOUDFLARE_TUNNEL_TOKEN=' .env; }; then
    tmp=$(umask 077 && mktemp .env.XXXXXX)
    # Never leave a partial copy (which holds the token) behind.
    trap 'rm -f "$tmp"' EXIT
    [[ -f .env ]] || : > .env
    TOKEN=$token awk '
        /^CLOUDFLARE_TUNNEL_TOKEN=/ { print "CLOUDFLARE_TUNNEL_TOKEN=" ENVIRON["TOKEN"]; done = 1; next }
        { print }
        END { if (!done) print "CLOUDFLARE_TUNNEL_TOKEN=" ENVIRON["TOKEN"] }
    ' .env > "$tmp"
    mv "$tmp" .env
    trap - EXIT
    echo "Set CLOUDFLARE_TUNNEL_TOKEN in .env: source it again before a rebuild"
fi
unset token

if $env_only; then
    echo ""
    echo "Next: set -a && source .env && set +a, then run the GENERATE_SECRETS build,"
    echo "which seals the token for cloudflared itself."
    exit 0
fi

echo ""
echo "Next: commit $dest, open a PR and merge it. Once ArgoCD has synced it,"
echo "restart cloudflared: kubectl -n cloudflared rollout restart deployment/cloudflared"
echo "then disconnect every old connection: just cf-tunnel-disconnect"
