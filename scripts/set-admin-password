#!/usr/bin/env bash
# Set the shared admin password: the admin-auth Secret in the monitoring
# namespace, which Grafana's built-in admin account reads (user/password
# keys). The auth key holds an htpasswd line for any ingress in that
# namespace with basic_auth: true. Reads ADMIN_PASSWORD from env or
# prompts interactively.
set -euo pipefail
PASSWORD="${ADMIN_PASSWORD:-}"
if [ -z "$PASSWORD" ]; then printf "Enter admin password: " && read -rs PASSWORD < /dev/tty && echo; fi
HTPASSWD=$(htpasswd -nb admin "$PASSWORD")
ns=monitoring
kubectl create namespace "$ns" --dry-run=client -o yaml | kubectl apply -f -
kubectl create secret generic admin-auth -n "$ns" \
    --from-literal=auth="$HTPASSWD" \
    --from-literal=user=admin \
    --from-literal=password="$PASSWORD" \
    --dry-run=client -o yaml | kubectl apply -f -
echo "Set admin-auth in $ns"
