#!/usr/bin/env bash
# Run lint and docs checks in parallel, fail if either fails.
set -euo pipefail
# The age public key is set in two places; they must match.
uv run scripts/check-age-recipient
# The off-site backup's upload step, under busybox with rclone's local
# backend (a few seconds).
scripts/test-offsite-send
# The install stick's seeds, GRUB menu and disk guard, without the ISO
# (a second or two).
uv run scripts/test-make-install-stick
# The sealing-key unseal check, with throwaway keys (a few seconds).
scripts/test-unseal-check
# No Ansible destroys stored data (the NAS guarantee in the README).
uv run scripts/check-no-destroy
# ... and that check catches what it should (a copy of the repo, ~10 s).
uv run scripts/test-check-no-destroy
just lint & pid_lint=$!
just docs & pid_docs=$!
fail=0
wait $pid_lint  || fail=1
wait $pid_docs  || fail=1
exit $fail
