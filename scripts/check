#!/usr/bin/env bash
# Run lint and docs checks in parallel, fail if either fails.
set -euo pipefail
# The age public key is set in two places; they must match.
uv run scripts/check-age-recipient
just lint & pid_lint=$!
just docs & pid_docs=$!
fail=0
wait $pid_lint  || fail=1
wait $pid_docs  || fail=1
exit $fail
