#!/usr/bin/env bash
# Tests the install stick's generated files, without the ISO: renders the
# seeds and GRUB menu from hosts.yml (install/render.py) into a temp dir
# and checks that
#   - each user-data parses as YAML and has the autoinstall keys;
#   - each host's entry has the disk guard with its own serial and MACs,
#     and a storage match on that serial;
#   - the new-hardware entry has no guard, no storage and no `autoinstall`
#     on its kernel line, and each host's entry has it;
#   - each host's guard, run with stand-ins for lsblk, udevadm and the
#     network ports, installs only when one of the host's MACs is present
#     and exactly one disk has the serial (and the model, when set);
#   - a host with install_profile but no serial or MACs is left off, with a
#     warning, and a private key given as a key is refused.
# Run by `just check` (under uv run, for PyYAML).
#
# Usage: scripts/test-make-install-stick
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/test-make-install-stick.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
# The guard writes its refusals to the console for the installer's operator:
# send them nowhere, or they land on the terminal running this test.
export INSTALL_CONSOLE=/dev/null
fail=0
ok() { echo "ok $*"; }
bad() {
    echo "FAIL $*"
    fail=1
}

# A stand-in for the ISO's grub.cfg (Ubuntu 26.04 live server's layout).
cat >"$tmp/grub.iso.cfg" <<'EOF'
set timeout=30
set default=0

loadfont unicode

set menu_color_normal=white/black
set menu_color_highlight=black/light-gray

menuentry "Try or Install Ubuntu Server" {
	set gfxpayload=keep
	linux	/casper/vmlinuz  ---
	initrd	/casper/initrd
}
grub_platform
if [ "$grub_platform" = "efi" ]; then
menuentry 'Boot from next volume' {
	exit 1
}
menuentry 'UEFI Firmware Settings' {
	fwsetup
}
fi
EOF
echo "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAITestKeyOnly test@example" >"$tmp/test.pub"

python3 "$repo/install/render.py" --inventory "$repo/hosts.yml" \
    --group-vars "$repo/group_vars/all.yml" \
    --key "$repo/pub_keys/ansible_rsa.pub" --key "$tmp/test.pub" \
    --out "$tmp/install" --grub-in "$tmp/grub.iso.cfg" --grub-out "$tmp/grub.cfg" \
    >"$tmp/render.out"

# YAML structure, per host, against hosts.yml.
python3 - "$repo/hosts.yml" "$tmp/install" "$tmp/grub.cfg" <<'EOF' || fail=1
import re, sys
from pathlib import Path
import yaml

inv, seeds, grub = sys.argv[1], Path(sys.argv[2]), Path(sys.argv[3]).read_text()
fail = False
def check(cond, msg):
    global fail
    print(("ok " if cond else "FAIL ") + msg)
    fail |= not cond

hosts = {}
def walk(g):
    if not isinstance(g, dict):
        return
    for h, v in (g.get("hosts") or {}).items():
        hosts.setdefault(h, {}).update(v or {})
    for c in (g.get("children") or {}).values():
        walk(c)
for g in yaml.safe_load(Path(inv).read_text()).values():
    walk(g)
want = {h: v for h, v in hosts.items() if "install_profile" in v}
check({"gknas", "nuc1", "nuc2"} <= set(want), "gknas, nuc1 and nuc2 have install_profile")

entries = {}
for m in re.finditer(r'menuentry "[^"]*" --id install-(\S+) \{\n(.*?)\n\}', grub, re.S):
    entries[m.group(1)] = m.group(2)
check(set(entries) == set(want) | {"new"}, f"grub entries {sorted(entries)}")
check("set timeout=-1" in grub and "set timeout=30" not in grub
      and "set default" not in grub, "grub waits for a choice, with no default")

for host in sorted(want) + ["new"]:
    path = seeds / host / "user-data"
    text = path.read_text()
    check(text.startswith("#cloud-config\n"), f"{host}: #cloud-config header")
    ai = yaml.safe_load(text)["autoinstall"]
    check((seeds / host / "meta-data").is_file(), f"{host}: meta-data")
    ud = ai["user-data"]
    user = ud["users"][0]
    check(user["name"] == "ansible" and user["lock_passwd"] is True
          and user["sudo"] == ["ALL=(ALL) NOPASSWD:ALL"], f"{host}: ansible account, locked, sudo")
    check(len(user["ssh_authorized_keys"]) == 2
          and all(k.startswith("ssh-") for k in user["ssh_authorized_keys"]), f"{host}: public keys")
    check("PRIVATE" not in text and "passwd:" not in text.replace("lock_passwd:", ""), f"{host}: no secrets")
    check(ai["ssh"]["install-server"] is True and ai["ssh"]["allow-pw"] is False, f"{host}: openssh-server")
    check(ai["timezone"] == "Europe/London" and ai["locale"] == "en_GB.UTF-8", f"{host}: locale, timezone")
    kernel = next(l for l in entries[host].splitlines() if l.strip().startswith("linux"))
    check(f"ds=nocloud\\;s=/cdrom/install/{host}/" in kernel, f"{host}: kernel line points at its seed")
    if host == "new":
        check(" autoinstall" not in kernel, "new: no autoinstall on the kernel line")
        check("early-commands" not in ai and "storage" not in ai
              and "storage" in ai["interactive-sections"], "new: storage is interactive")
        check(ud["hostname"] == "new-host", "new: hostname new-host")
        continue
    v = want[host]
    serial = v["install_disk_serial"]
    check(" autoinstall " in kernel, f"{host}: autoinstall on the kernel line")
    check(ai["interactive-sections"] == [], f"{host}: no interactive sections")
    guard = ai["early-commands"][0]
    check(f"INSTALL_DISK_SERIAL='{serial}'" in guard and "exactly one disk" in guard,
          f"{host}: guard for serial {serial}")
    macs = " ".join(v["install_machine_macs"])
    check(f"INSTALL_MACHINE_MACS='{macs}'" in guard and "udevadm settle" in guard,
          f"{host}: guard for MACs {macs}")
    check(ai["storage"]["layout"] == {"name": "direct", "match": {"serial": f"*{serial}*"}},
          f"{host}: storage matches the serial")
    check(ud["hostname"] == host, f"{host}: hostname")
    check(user.get("uid") == v.get("install_ansible_uid"), f"{host}: ansible uid {user.get('uid')}")
    check(ai["shutdown"] == "poweroff", f"{host}: powers off when done")
    desktop = v["install_profile"] == "desktop"
    check(("ubuntu-desktop-minimal" in ai.get("packages", [])) == desktop, f"{host}: {v['install_profile']} profile")
    late = " ".join(ai.get("late-commands", []))
    check(("disable systemd-networkd.service" in late) == desktop, f"{host}: networkd off only on a desktop")
    (seeds.parent / f"guard-{host}.sh").write_text(guard)
sys.exit(1 if fail else 0)
EOF

# Run each host's rendered guard against fake disks, a fake EFI dir and
# fake network ports. The lsblk and udevadm stand-ins read $FAKE (lines of:
# name serial id_serial model...); the ports are $tmp/net/*/address.
mkdir -p "$tmp/bin"
cat >"$tmp/bin/lsblk" <<'EOF'
#!/bin/sh
# Only the calls the guard makes.
case "$*" in
*NAME,TYPE*) awk '{print "/dev/" $1 " disk"}' "$FAKE" ;;
*-o\ NAME,SIZE*) cat "$FAKE" ;;
*SERIAL*) awk -v d="${*##* }" '"/dev/" $1 == d {print $2}' "$FAKE" ;;
*MODEL*) awk -v d="${*##* }" '"/dev/" $1 == d {$1 = $2 = $3 = ""; sub(/^ +/, ""); print $0 "  "}' "$FAKE" ;;
esac
EOF
cat >"$tmp/bin/udevadm" <<'EOF'
#!/bin/sh
case "$1" in settle) exit 0 ;; esac
d=${*##*--name=}
awk -v d="$d" '"/dev/" $1 == d {print "ID_SERIAL=" $3; print "ID_SERIAL_SHORT=" $2}' "$FAKE"
EOF
chmod +x "$tmp/bin/lsblk" "$tmp/bin/udevadm"

# Usage: guard_case <host> <want-exit> <description> <MAC...>, disks on stdin
guard_case() {
    local host=$1 want=$2 desc=$3 rc=0 i=0 mac
    shift 3
    cat >"$tmp/fake"
    rm -rf "$tmp/net"
    mkdir -p "$tmp/net/lo"
    echo 00:00:00:00:00:00 >"$tmp/net/lo/address"
    for mac in "$@"; do
        i=$((i + 1))
        mkdir -p "$tmp/net/en$i"
        echo "$mac" >"$tmp/net/en$i/address"
    done
    FAKE=$tmp/fake PATH="$tmp/bin:$PATH" INSTALL_EFI_DIR=${efi:-$tmp} \
        INSTALL_NET_DIR=$tmp/net sh "$tmp/guard-$host.sh" >/dev/null 2>&1 || rc=$?
    if [ "$rc" -eq "$want" ] || { [ "$want" -ne 0 ] && [ "$rc" -ne 0 ]; }; then
        ok "guard $host: $desc"
    else
        bad "guard $host: $desc (exit $rc)"
    fi
}
nas_mac=24:5e:be:47:a3:05
# gknas: the Fanxiang NVMe in the PCIe slot, among the NAS's other disks.
guard_case gknas 0 "one matching disk installs" $nas_mac <<'EOF'
sda S5STNF0W510784T Samsung_SSD_870_S5STNF0W510784T Samsung SSD 870
sdb S5STNF0W503712A Samsung_SSD_870_S5STNF0W503712A Samsung SSD 870
sdc 00000000NT12349D LaCie_Mobile_Drive_00000000NT12349D Mobile Drive
mmcblk0 0x8cdbed67 0x8cdbed67 DOM
nvme0n1 26100800643000458 Fanxiang_S500Pro_256GB_26100800643000458_1 Fanxiang S500Pro 256GB
EOF
guard_case gknas 0 "an upper-case MAC still matches" 24:5E:BE:47:A3:04 <<'EOF'
nvme0n1 26100800643000458 Fanxiang_S500Pro_256GB_26100800643000458_1 Fanxiang S500Pro 256GB
EOF
guard_case gknas 1 "the disk on another machine (no MAC matches) refuses" 54:b2:03:fd:53:1c <<'EOF'
nvme0n1 26100800643000458 Fanxiang_S500Pro_256GB_26100800643000458_1 Fanxiang S500Pro 256GB
EOF
guard_case gknas 0 "a disk whose serial is only in udev's ID_SERIAL installs" $nas_mac <<'EOF'
nvme0n1 XXXX Fanxiang_S500Pro_256GB_26100800643000458_1 Fanxiang S500Pro 256GB
EOF
guard_case gknas 1 "two disks, one matching only in ID_SERIAL, refuse" $nas_mac <<'EOF'
nvme0n1 XXXX Fanxiang_S500Pro_256GB_26100800643000458_1 Fanxiang S500Pro 256GB
nvme1n1 26100800643000458 Fanxiang_S500Pro_256GB_26100800643000458_1 Fanxiang S500Pro 256GB
EOF
guard_case gknas 1 "no matching disk refuses" $nas_mac <<'EOF'
sda S5STNF0W510784T Samsung_SSD_870_S5STNF0W510784T Samsung SSD 870
EOF
guard_case gknas 1 "the NVMe back in its USB enclosure (the enclosure's serial) refuses" $nas_mac <<'EOF'
sdd DD564198838AA JMicron_Tech_DD564198838AA Tech
EOF
guard_case gknas 1 "two matching disks refuse" $nas_mac <<'EOF'
nvme0n1 26100800643000458 Fanxiang_S500Pro_256GB_26100800643000458_1 Fanxiang S500Pro 256GB
nvme1n1 26100800643000458 Fanxiang_S500Pro_256GB_26100800643000458_1 Fanxiang S500Pro 256GB
EOF
guard_case gknas 1 "the serial on the wrong model refuses" $nas_mac <<'EOF'
nvme0n1 26100800643000458 Fanxiang_S500Pro_256GB_26100800643000458_1 Other
EOF
efi=$tmp/no-such-dir guard_case gknas 1 "a legacy BIOS boot refuses" $nas_mac <<'EOF'
nvme0n1 26100800643000458 Fanxiang_S500Pro_256GB_26100800643000458_1 Fanxiang S500Pro 256GB
EOF
# nuc2: the 980 PRO among the 870 QVO and the Crucial X6.
nuc2_disks='sda S5RRNF0RC38740V Samsung_SSD_870_QVO_1TB_S5RRNF0RC38740V Samsung SSD 870 QVO 1TB
sdc 2143E4A033DD Micron_Crucial_X6_SSD_2143E4A033DD Crucial X6 SSD
nvme0n1 S5GXNF0RA03936L Samsung_SSD_980_PRO_1TB_S5GXNF0RA03936L_1 Samsung SSD 980 PRO 1TB'
guard_case nuc2 0 "the 980 PRO installs" 48:21:0b:31:f0:89 <<<"$nuc2_disks"
guard_case nuc2 1 "without the 980 PRO refuses" 54:b2:03:fd:53:1c <<<"${nuc2_disks%$'\n'*}"
guard_case nuc2 1 "on nuc1 (wrong MACs) refuses" 1c:69:7a:61:65:d4 <<<"$nuc2_disks"
# nuc1: its one SATA SSD.
guard_case nuc1 0 "the 860 EVO installs" 1c:69:7a:61:65:d4 <<'EOF'
sda S5GFNG0N302036V Samsung_SSD_860_EVO_M.2_250GB_S5GFNG0N302036V Samsung SSD 860 EVO M.2 250GB
EOF
guard_case nuc1 1 "another disk refuses" 1c:69:7a:61:65:d4 <<'EOF'
sda S5GFNG0N999999X Samsung_SSD_860_EVO_M.2_250GB_S5GFNG0N999999X Samsung SSD 860 EVO M.2 250GB
EOF

# A host with install_profile but no serial, or no MACs, is left off, with
# a warning.
cat >"$tmp/hosts.yml" <<'EOF'
all_nodes:
  hosts:
    box1:
      install_profile: server
      install_machine_macs: ["02:00:00:00:00:01"]
    box2:
      install_profile: server
      install_disk_serial: ABC123456
      install_machine_macs: ["02:00:00:00:00:02"]
    box3:
      install_profile: server
      install_disk_serial: ABC123457
EOF
if python3 "$repo/install/render.py" --inventory "$tmp/hosts.yml" --key "$tmp/test.pub" \
    --out "$tmp/install2" 2>"$tmp/warn" >"$tmp/out2" &&
    grep -q "box1: no usable install_disk_serial" "$tmp/warn" &&
    grep -q "box3: no usable install_machine_macs" "$tmp/warn" &&
    grep -qx "entries: new box2" "$tmp/out2" &&
    [ ! -e "$tmp/install2/box1" ] && [ ! -e "$tmp/install2/box3" ]; then
    ok "a host with no serial or no MACs is left off, with a warning"
else
    bad "a host with no serial or no MACs is left off, with a warning"
fi

# A private key given as a key is refused, and nothing is written.
printf -- '-----BEGIN OPENSSH PRIVATE KEY-----\nb3BlbnNzaC1rZXktdjEAAAAA\n-----END OPENSSH PRIVATE KEY-----\n' >"$tmp/id_test"
if ! python3 "$repo/install/render.py" --inventory "$tmp/hosts.yml" --key "$tmp/id_test" \
    --out "$tmp/install3" >/dev/null 2>"$tmp/err3" &&
    grep -q "holds a private key" "$tmp/err3" && [ ! -e "$tmp/install3" ]; then
    ok "a private key is refused"
else
    bad "a private key is refused"
fi

exit $fail
