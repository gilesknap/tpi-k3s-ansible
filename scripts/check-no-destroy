#!/usr/bin/env python3
"""Fail if the Ansible in this repo could destroy stored data.

The guarantee the README makes about the NAS (gknas), enforced:

1. No Ansible YAML or Jinja file runs a destructive storage command
   (zpool destroy/labelclear, zfs destroy/rollback, wipefs, sgdisk --zap,
   blkdiscard, mkfs, dd to a device, syncoid --force-delete, zpool create)
   or uses the zfs/zpool modules with any state but present. The few
   legitimate uses, all in the RK1 flash role, are in ALLOWLIST below with
   their reason; nothing of roles/nas or pb_nas.yml is allowlisted.
2. The one exception in the nas role, `zpool create`, is allowed only in
   the task of roles/nas/tasks/pool.yml that is gated as checked in
   check_pool_create(): opt-in (nas_create_pool / nas_create_backup_pool,
   off by default), never over an imported or importable pool, and -f
   only with nas_force (also off by default).
3. The cluster playbooks (every pb_*.yml but pb_nas.yml, and what they
   import) never target or delegate to the NAS, and never run the nas
   role.

Run by `just check` and the pre-commit hooks. Comment lines are skipped.
"""

import re
import subprocess
import sys
from pathlib import Path

import yaml

REPO = Path(__file__).resolve().parent.parent
SKIP_DIRS = ("docs/", ".claude/", "_claude/")
NAS_FILES = ("roles/nas/", "pb_nas.yml")
POOL_TASKS = "roles/nas/tasks/pool.yml"

# Destructive storage commands. Each matches the shell form and the argv
# list form (`['zfs', 'destroy']`).
PATTERNS = {
    "zpool destroy": r"\bzpool\W+destroy\b",
    "zpool labelclear": r"\bzpool\W+labelclear\b",
    "zpool create": r"\bzpool\W+create\b",
    "zfs destroy": r"\bzfs\W+destroy\b",
    "zfs rollback": r"\bzfs\W+rollback\b",
    # wipefs --no-act (-n) only lists the signatures; any other wipefs erases.
    "wipefs": r"\bwipefs\b(?![^\n]*(--no-act|\s-n\b))",
    "sgdisk zap": r"\bsgdisk\b[^\n]*(--zap|\s-Z\b)",
    "blkdiscard": r"\bblkdiscard\b",
    "mkfs": r"\bmkfs\b",
    # dd onto a device, or onto a target only known at run time.
    "dd to a device": r"\bdd\b[^\n]*\bof=(/dev/(?!null\b|zero\b)|\{\{|\$)",
    "syncoid --force-delete": r"\bsyncoid\b[^\n]*--force-delete",
}

# (file, pattern): why it is legitimate. Only the RK1 flash role, which
# installs Ubuntu onto a node's own NVMe and eMMC (never the NAS): see
# CLAUDE.md for its rules on the eMMC. Every entry must still match.
ALLOWLIST = {
    ("roles/flash/tasks/rk1_install_nvme.yml", "wipefs"): (
        "re-flash of an RK1: clears the NVMe before writing the image, and"
        " the eMMC's partition table after the install (opt-in flash_force"
        " for an NVMe with a partition table)"
    ),
    ("roles/flash/tasks/rk1_install_nvme.yml", "dd to a device"): (
        "re-flash of an RK1: writes the Ubuntu image onto its NVMe"
    ),
    ("roles/flash/tasks/bootstrap.yml", "wipefs"): (
        "text of a fail message telling the user how to keep an RK1's NVMe"
        " install; runs nothing"
    ),
}

# The zfs/zpool modules; any state but present destroys.
ZFS_MODULES = {"community.general.zfs", "community.general.zpool", "zfs", "zpool"}

errors = []


def rel(path):
    return str(path.relative_to(REPO))


def is_nas(path):
    return path.startswith(NAS_FILES)


def ansible_files():
    out = subprocess.run(
        ["git", "ls-files", "--cached", "--others", "--exclude-standard"],
        cwd=REPO,
        capture_output=True,
        text=True,
        check=True,
    ).stdout.split()
    return sorted(
        f
        for f in set(out)
        if re.search(r"\.(ya?ml|j2)$", f)
        and not f.startswith(SKIP_DIRS)
        and (REPO / f).is_file()
    )


def load_yaml(path):
    try:
        return yaml.safe_load((REPO / path).read_text())
    except yaml.YAMLError:
        return None  # a Helm or Jinja template: line patterns only


def walk(node):
    """Every dict in a parsed YAML document."""
    if isinstance(node, dict):
        yield node
        for v in node.values():
            yield from walk(v)
    elif isinstance(node, list):
        for v in node:
            yield from walk(v)


def check_pool_create():
    """Check the gating of the only zpool create; return its line range."""
    text = (REPO / POOL_TASKS).read_text()
    root = yaml.compose(text)
    tasks = yaml.safe_load(text)
    found = None
    for i, node in enumerate(root.value):
        keys = {k.value: v for k, v in node.value}
        for sub in keys["block"].value if "block" in keys else []:
            if re.search(PATTERNS["zpool create"], text[sub.start_mark.index : sub.end_mark.index]):
                found = (tasks[i], sub)
    if not found:
        errors.append(f"{POOL_TASKS}: no gated block holds the zpool create task")
        return None
    block, sub = found
    when = [str(w) for w in (block.get("when") or [])]
    for need in ("nas_pool_list.rc != 0", "nas_pool_imported is skipped", "nas_pool_create | bool"):
        if need not in when:
            errors.append(f"{POOL_TASKS}: the zpool create block must be gated on `{need}`")
    asserts = [
        t["ansible.builtin.assert"]
        for t in block.get("block", [])
        if "ansible.builtin.assert" in t
    ]
    if not any("nas_force | bool or" in str(a.get("that")) for a in asserts):
        errors.append(f"{POOL_TASKS}: the zpool create block must refuse non-blank disks unless nas_force")
    create = text[sub.start_mark.index : sub.end_mark.index]
    if "['-f'] if nas_force | bool else []" not in create or re.search(r"['\"]-f['\"](?!\] if nas_force)", create):
        errors.append(f"{POOL_TASKS}: zpool create may pass -f only when nas_force")
    main = (REPO / "roles/nas/tasks/main.yml").read_text()
    for need in (
        'nas_pool_create: "{{ nas_create_pool | bool }}"',
        'nas_pool_create: "{{ nas_create_backup_pool | bool }}"',
    ):
        if need not in main:
            errors.append(f"roles/nas/tasks/main.yml: pool.yml must be included with {need}")
    defaults = yaml.safe_load((REPO / "roles/nas/defaults/main.yml").read_text())
    for var in ("nas_create_pool", "nas_create_backup_pool", "nas_force"):
        if defaults.get(var) is not False:
            errors.append(f"roles/nas/defaults/main.yml: {var} must default to false")
    return (sub.start_mark.line + 1, sub.end_mark.line)


def check_commands(files, pool_create_lines):
    used = set()
    for path in files:
        for n, line in enumerate((REPO / path).read_text().splitlines(), 1):
            if re.match(r"\s*(#|\{#)", line):
                continue
            for name, pattern in PATTERNS.items():
                if not re.search(pattern, line):
                    continue
                if (
                    name == "zpool create"
                    and path == POOL_TASKS
                    and pool_create_lines
                    and pool_create_lines[0] <= n <= pool_create_lines[1]
                ):
                    continue
                if (path, name) in ALLOWLIST:
                    used.add((path, name))
                    continue
                errors.append(f"{path}:{n}: destructive `{name}`: {line.strip()}")
        for d in walk(load_yaml(path)):
            for mod in ZFS_MODULES & d.keys():
                args = d[mod] if isinstance(d[mod], dict) else {}
                if args.get("state", "present") != "present":
                    errors.append(f"{path}: {mod} with state {args.get('state')}: {args.get('name')}")
    for key in ALLOWLIST:
        if is_nas(key[0]):
            errors.append(f"ALLOWLIST: nothing of the NAS may be allowlisted: {key}")
        elif key not in used:
            errors.append(f"ALLOWLIST: stale entry, remove it: {key}")


def inventory_groups():
    """{group: set of hosts}, children included, from hosts.yml."""
    inv = yaml.safe_load((REPO / "hosts.yml").read_text())

    def hosts(name, seen=()):
        g = inv.get(name) or {}
        out = set((g.get("hosts") or {}).keys())
        for child in (g.get("children") or {}).keys():
            if child not in seen:
                out |= hosts(child, seen + (name,))
        return out

    groups = {name: hosts(name) for name in inv}
    groups["all"] = set().union(*groups.values())
    return groups


def check_cluster_playbooks():
    groups = inventory_groups()
    nas_hosts = groups.get("nas", set())
    if not nas_hosts:
        errors.append("hosts.yml: no hosts in the nas group")
    nas_names = nas_hosts | {g for g, h in groups.items() if h & nas_hosts}
    # The roles delegate to "{{ control_plane }}" (allowed below).
    if (load_yaml("group_vars/all.yml") or {}).get("control_plane") in nas_hosts:
        errors.append("group_vars/all.yml: control_plane is a NAS host")

    def targets_nas(pattern):
        if "{{" in str(pattern):
            return True  # unknown until run time
        for tok in re.split(r"[,:]", str(pattern)):
            tok = tok.strip().lstrip("!&")
            if tok in nas_names or "*" in tok or tok.startswith("~"):
                return True
        return False

    playbooks = [p for p in sorted(REPO.glob("pb_*.yml")) if p.name != "pb_nas.yml"]
    seen_pb, roles, todo = set(), set(), list(playbooks)
    while todo:
        pb = todo.pop()
        if pb in seen_pb:
            continue
        seen_pb.add(pb)
        for play in yaml.safe_load(pb.read_text()) or []:
            if "import_playbook" in play:
                todo.append(pb.parent / play["import_playbook"])
                continue
            if targets_nas(play.get("hosts", "")):
                errors.append(f"{rel(pb)}: play {play.get('name')!r} targets the NAS: hosts {play.get('hosts')}")
            for r in play.get("roles") or []:
                roles.add(r["role"] if isinstance(r, dict) else r)
            check_tasks(rel(pb), play, roles, targets_nas)

    done = set()
    while roles - done:
        role = (roles - done).pop()
        done.add(role)
        if role == "nas":
            errors.append("a cluster playbook runs the nas role")
            continue
        for f in sorted((REPO / "roles" / role).glob("**/*.yml")):
            check_tasks(rel(f), load_yaml(rel(f)), roles, targets_nas)
        for meta in (REPO / "roles" / role / "meta").glob("main.yml"):
            for dep in (load_yaml(rel(meta)) or {}).get("dependencies") or []:
                roles.add(dep["role"] if isinstance(dep, dict) else dep)


def check_tasks(path, data, roles, targets_nas):
    for d in walk(data):
        for key in ("ansible.builtin.include_role", "ansible.builtin.import_role", "include_role", "import_role"):
            if isinstance(d.get(key), dict):
                roles.add(d[key]["name"])
        if "delegate_to" in d and targets_nas(d["delegate_to"]) and d["delegate_to"] != "{{ control_plane }}":
            errors.append(f"{path}: delegates to the NAS: {d['delegate_to']}")


files = ansible_files()
check_commands(files, check_pool_create())
check_cluster_playbooks()
if errors:
    print("ERROR: Ansible that could destroy data (see scripts/check-no-destroy):", file=sys.stderr)
    for e in errors:
        print(f"  {e}", file=sys.stderr)
    sys.exit(1)
print(f"no destructive storage commands outside the allowlist ({len(files)} files)")
