#!/usr/bin/env bash
# Tests send() in kubernetes-services/additions/backups/files/offsite-lib.sh,
# the off-site backup's upload step, for both targets (drive: a temporary
# .partial- name renamed on success; b2: straight to the final name through
# a fifo). It runs the library under busybox sh, as the rclone image does,
# with the real rclone against its local backend standing in for the
# remote, and a stand-in for age (the encryption is not under test).
#
# The local backend writes a streamed file in place as it arrives, where B2
# shows a large file only once rclone finishes it (after the end of the
# stream). So for b2 the cases raise --streaming-upload-cutoff above every
# stream, and rclone buffers each whole stream before writing: as on B2,
# only a stream rclone saw the end of becomes a file.
#
# For each target it checks that a good upload lands under its name, and
# that a producer that fails part-way (after writing some of the stream),
# or at once, makes send fail and leaves nothing under the destination's
# name (nor a .partial- file). It also checks that an rclone rcat that
# fails a couple of times (as on B2's 503 too_busy) is retried until the
# upload lands, and that one that always fails still fails after the
# retries, leaving nothing behind. Last, it checks that offsite-backups.sh
# logs diagnostics for a listing that hit an unreadable folder, and still
# fails. Run by `just check`.
#
# Usage: scripts/test-offsite-send
set -euo pipefail

here=$(cd "$(dirname "$0")/.." && pwd)
lib=$here/kubernetes-services/additions/backups/files/offsite-lib.sh

for tool in busybox rclone; do
    if ! command -v "$tool" >/dev/null; then
        echo "test-offsite-send: $tool not found, skipped" >&2
        exit 0
    fi
done

tmp=$(mktemp -d "${TMPDIR:-/tmp}/test-offsite-send.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/bin" "$tmp/remote" "$tmp/work"
# age stand-in: passes the stream through.
printf '#!/bin/sh\nexec cat\n' >"$tmp/bin/age"
chmod +x "$tmp/bin/age"
# rclone stand-in: an rcat fails while the count in $RCAT_FAILS is above 0
# (each failure takes one off), after reading the stream and, for a Drive
# .partial- name, writing it there; anything else is the real rclone.
cat >"$tmp/bin/rclone" <<EOF
#!/bin/sh
if [ "\$1" = rcat ] && [ "\$(cat "\$RCAT_FAILS" 2>/dev/null || echo 0)" -gt 0 ]; then
    echo \$((\$(cat "\$RCAT_FAILS") - 1)) >"\$RCAT_FAILS"
    case \$2 in */.partial-*) cat >"\$2" ;; *) cat >/dev/null ;; esac
    echo "Failed to rcat: Too busy (503 too_busy)" >&2
    exit 1
fi
exec $(command -v rclone) "\$@"
EOF
chmod +x "$tmp/bin/rclone"

# The cases, in busybox sh. Each prints "ok ..." or "FAIL ...".
cat >"$tmp/cases.sh" <<'EOF'
set -eu
set -o pipefail
# shellcheck source=/dev/null
. "$LIB"
failed=0
check() { # NAME EXPECTED-RC RC DEST [CONTENT]
    _why=
    if [ "$2" = 0 ] && [ "$3" -ne 0 ]; then _why="returned $3"; fi
    if [ "$2" != 0 ] && [ "$3" -eq 0 ]; then _why="returned 0"; fi
    if [ $# -ge 5 ]; then
        [ "$(cat "$4" 2>/dev/null)" = "$5" ] || _why="$_why; wrong or no file"
    elif [ -e "$4" ]; then
        _why="$_why; left $4"
    fi
    for _p in "${4%/*}"/.partial-*; do
        [ -e "$_p" ] && _why="$_why; left ${_p##*/}"
    done
    if [ -n "$_why" ]; then
        echo "FAIL $TARGET $1:$_why"
        failed=1
    else
        echo "ok   $TARGET $1"
    fi
}
# Writes some of the stream, then fails after rclone has started reading.
fail_late() { head -c "$1" /dev/zero | tr '\0' x; sleep 1; return 3; }
for TARGET in drive b2; do
    if [ "$TARGET" = b2 ]; then export RCLONE_STREAMING_UPLOAD_CUTOFF=10M; fi
    d=$REMOTE/$TARGET
    mkdir -p "$d"
    rc=0; send "$d/good.age" age printf 'hello\n' || rc=$?
    check "good upload" 0 "$rc" "$d/good.age" hello
    rc=0; send "$d/late-small.age" age fail_late 1000 || rc=$?
    check "producer fails part-way (small stream)" 1 "$rc" "$d/late-small.age"
    rc=0; send "$d/late-large.age" age fail_late 300000 || rc=$?
    check "producer fails part-way (large stream)" 1 "$rc" "$d/late-large.age"
    rc=0; send "$d/missing.age" as-is cat "$WORK/no-such-file" 2>/dev/null || rc=$?
    check "producer fails at once" 1 "$rc" "$d/missing.age"
    echo 2 >"$RCAT_FAILS"
    rc=0; RETRY_PAUSES="0 0 0" send "$d/busy.age" age printf 'hello\n' || rc=$?
    check "rcat fails twice, then succeeds" 0 "$rc" "$d/busy.age" hello
    echo 9 >"$RCAT_FAILS"
    rc=0; RETRY_PAUSES="0 0 0" send "$d/down.age" age printf 'hello\n' || rc=$?
    check "rcat always fails" 1 "$rc" "$d/down.age"
    left=$(cat "$RCAT_FAILS")
    if [ "$left" -ne 5 ]; then
        echo "FAIL $TARGET rcat always fails: $((9 - left)) tries, not 4"
        failed=1
    fi
    echo 0 >"$RCAT_FAILS"
done
exit "$failed"
EOF

PATH=$tmp/bin:$PATH RCLONE_CONFIG=/dev/null LIB=$lib REMOTE=$tmp/remote \
    WORK=$tmp/work AGE_RECIPIENT=age1test RETRY_PAUSES=0 \
    RCAT_FAILS=$tmp/rcat-fails \
    busybox sh "$tmp/cases.sh" 2>"$tmp/stderr" || {
    echo "--- stderr" >&2
    cat "$tmp/stderr" >&2
    exit 1
}

# offsite-backups.sh's find diagnostics: a listing of the others scope that
# reports an unreadable folder once (a stand-in find, as on 21 Nov 2026)
# logs them, finds the second listing clean, and still fails the run.
printf '#!/bin/sh\n[ "$1" = --version ] && echo test && exit 0\nexec cat\n' >"$tmp/bin/age"
cat >"$tmp/bin/find" <<EOF
#!/bin/sh
if [ -e "$tmp/find-fail" ]; then
    rm "$tmp/find-fail"
    echo "find: ./scrap: Permission denied" >&2
fi
exec $(command -v find) "\$@"
EOF
chmod +x "$tmp/bin/find"
mkdir -p "$tmp/src/etcd" "$tmp/src/scrap" "$tmp/remote/full/backups" "$tmp/work2"
echo bundle >"$tmp/src/etcd/a.tar"
touch -d '1 hour ago' "$tmp/src/etcd/a.tar"
: >"$tmp/rclone.conf"
: >"$tmp/find-fail"
rc=0
PATH=$tmp/bin:$PATH TARGET=drive DEST_ROOT=$tmp/remote/full \
    AGE_RECIPIENT=age1test RCLONE_SECRET=$tmp/rclone.conf WORK=$tmp/work2 \
    SRC=$tmp/src RUN_DIRS=scrap EXCLUDE='' PRUNE_DAYS=0 KEEP_MIN=4 \
    FIND_RECHECK_PAUSE=0 RCAT_FAILS=$tmp/rcat-fails \
    busybox sh "${lib%/*}/offsite-backups.sh" others >"$tmp/out" 2>&1 || rc=$?
why=
[ "$rc" -ne 0 ] || why="$why; returned 0"
grep -q 'find diagnostics: uid=' "$tmp/out" || why="$why; no id"
grep -q 'find diagnostics: d.* scrap$' "$tmp/out" || why="$why; no ls of scrap"
grep -q 'find diagnostics: second listing clean' "$tmp/out" || why="$why; no clean second listing"
grep -q 'ERROR: could not read all of' "$tmp/out" || why="$why; no error"
if [ -n "$why" ]; then
    echo "FAIL find diagnostics:$why"
    cat "$tmp/out" >&2
    exit 1
fi
echo "ok   find diagnostics"
