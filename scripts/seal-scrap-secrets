#!/usr/bin/env bash
# Reseal scrap's scrap-secrets SealedSecret from the live Secret, keeping
# what is not asked to change. Prints no secret value.
#
# Usage: scripts/seal-scrap-secrets [--api-key] [--canary new|revoke]
#
#   --api-key        ask for a new Claude API key (ANTHROPIC_API_KEY)
#   --canary new     generate a new canary MCP token (SCRAP_MCP_TOKEN_CANARY),
#                    the claude-canary VPS's own; replaces any old one
#   --canary revoke  remove the canary token: /mcp refuses it once the
#                    Secret syncs and scrap restarts
#
# The main MCP token (SCRAP_MCP_TOKEN) is always kept: every other MCP client
# holds a copy (rotate it with the rebuild's SCRAP_ROTATE_MCP_TOKEN). scrap
# reads SCRAP_MCP_TOKENS: the main token and the canary, comma separated.
#
# Then commit the sealed file, push, and once ArgoCD has synced it restart
# scrap (it reads the tokens at start):
#   kubectl -n scrap rollout restart deploy/scrap
# Read the canary token with `just scrap-canary-token`.
set -euo pipefail
cd "$(dirname "$0")/.."
. scripts/lib/seal.sh

DEST=kubernetes-services/additions/scrap/templates/scrap-secret.yaml
new_key=false canary=keep
while [ $# -gt 0 ]; do
    case "$1" in
        --api-key) new_key=true ;;
        --canary)
            canary=${2:-}
            [[ $canary == new || $canary == revoke ]] || { echo "--canary takes new or revoke" >&2; exit 2; }
            shift ;;
        *) sed -n '5,13p' "$0" >&2; exit 2 ;;
    esac
    shift
done

live() { kubectl get secret scrap-secrets -n scrap -o jsonpath="{.data.$1}" | base64 -d; }
key=$(live ANTHROPIC_API_KEY)
main=$(live SCRAP_MCP_TOKEN)
[ -n "$main" ] || { echo "ERROR: no SCRAP_MCP_TOKEN in the live scrap-secrets" >&2; exit 1; }
if $new_key; then
    read -rsp "Claude API key: " key; echo
fi
[ -n "$key" ] || { echo "ERROR: no Claude API key" >&2; exit 1; }
case $canary in
    keep) canary_token=$(live SCRAP_MCP_TOKEN_CANARY) ;;
    new) canary_token=$(python3 -c "import secrets; print(secrets.token_urlsafe(48)[:48])") ;;
    revoke) canary_token="" ;;
esac

# The values go through files in a private directory, never the command line.
umask 077
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
printf %s "$key" > "$tmp/ANTHROPIC_API_KEY"
printf %s "$main" > "$tmp/SCRAP_MCP_TOKEN"
if [ -n "$canary_token" ]; then
    printf %s "$canary_token" > "$tmp/SCRAP_MCP_TOKEN_CANARY"
    printf %s,%s "$main" "$canary_token" > "$tmp/SCRAP_MCP_TOKENS"
else
    printf %s "$main" > "$tmp/SCRAP_MCP_TOKENS"
fi
kubectl create secret generic scrap-secrets --namespace scrap --from-file="$tmp" \
    --dry-run=client -o yaml | seal_to "$DEST"
echo "Sealed $DEST (canary token: $([ -n "$canary_token" ] && echo present || echo none))"
