#!/usr/bin/env bash
# Set up (or update) frps on the VPS for the vps-relay service.
# Runs ON THE VPS, as root. See docs/how-to/vps-relay.md.
#
# Usage: sudo ./vps-relay-setup [--show-token] PROTO:PORTS [PROTO:PORTS ...]
#   PROTO:PORTS  one per vps_relay.forwards entry, e.g. tcp:30565-30584 or
#                udp:9000. Print the list for this repo's values with
#                `just vps-relay-forwards` in the devcontainer.
#   --show-token print the existing frp token (to seal it again) and exit.
#
# Idempotent: re-run it whenever vps_relay.forwards changes. It
#   - writes /etc/frp/frps.toml with allowPorts = exactly the given ports
#     and the control port bound to this host's tailnet IP only;
#   - creates /etc/frp/frps.env with a random token on first run (printed
#     once, for sealing) and keeps it on later runs;
#   - installs frps as a Podman Quadlet (/etc/containers/systemd/frps.container)
#     and (re)starts it;
#   - opens the forwarded ports publicly and the control port on tailscale0
#     only, with ufw or firewalld if either is active.
# It never removes firewall rules for ports you have dropped; do that by hand.
set -euo pipefail

FRP_VERSION=v0.71.0     # keep in step with images.frpc in additions/vps-relay/values.yaml
# Control port: must equal vps_relay.frp_port and the tailnet policy grant.
# Override with e.g. `sudo FRP_PORT=7001 ./vps-relay-setup ...`.
FRP_PORT=${FRP_PORT:-7000}
ETC=/etc/frp
QUADLET=/etc/containers/systemd/frps.container

die() { echo "ERROR: $*" >&2; exit 1; }
info() { echo "==> $*"; }

[ "$(id -u)" -eq 0 ] || die "run as root (sudo $0 ...)"

if [ "${1:-}" = "--show-token" ]; then
    [ -f "$ETC/frps.env" ] || die "$ETC/frps.env does not exist yet"
    sed -n 's/^FRP_AUTH_TOKEN=//p' "$ETC/frps.env"
    exit 0
fi

[ $# -gt 0 ] || die "give at least one forward, e.g. tcp:30565-30584 (see header)"
[[ "$FRP_PORT" =~ ^[1-9][0-9]*$ ]] && [ "$FRP_PORT" -le 65535 ] || die "bad FRP_PORT '$FRP_PORT'"

# ---- Preflight -----------------------------------------------------------
command -v podman >/dev/null || die "podman is not installed"
podman_ver=$(podman version --format '{{.Client.Version}}')
[ "$(printf '%s\n4.4\n' "$podman_ver" | sort -V | head -n1)" = "4.4" ] \
    || die "podman $podman_ver is too old for Quadlet (need 4.4+)"
command -v tailscale >/dev/null || die "tailscale is not installed"
ts_ip=$(tailscale ip -4 2>/dev/null | head -n1)
[ -n "$ts_ip" ] || die "tailscale is not up (no tailnet IPv4)"
info "tailnet IP: $ts_ip"
if ! tailscale status --json --peers=false 2>/dev/null | grep -q '"tag:'; then
    echo "WARNING: this node has no ACL tag. Tag it (e.g. tag:vps) so member-wide"
    echo "         grants do not let it reach the relay — docs/how-to/vps-relay.md Step 1."
fi

# ---- Parse forwards ------------------------------------------------------
allow_ports=""
fw_specs=()
for spec in "$@"; do
    [[ "$spec" =~ ^(tcp|udp):([1-9][0-9]*)(-([1-9][0-9]*))?$ ]] \
        || die "bad forward '$spec' (want tcp:N, udp:N or tcp:N-M)"
    proto=${BASH_REMATCH[1]} lo=${BASH_REMATCH[2]} hi=${BASH_REMATCH[4]:-${BASH_REMATCH[2]}}
    { [ "$lo" -ge 1 ] && [ "$lo" -le "$hi" ] && [ "$hi" -le 65535 ]; } \
        || die "bad port range in '$spec'"
    { [ "$FRP_PORT" -lt "$lo" ] || [ "$FRP_PORT" -gt "$hi" ]; } \
        || die "'$spec' overlaps the frp control port $FRP_PORT"
    allow_ports+="  { start = $lo, end = $hi },   # $spec"$'\n'
    fw_specs+=("$proto $lo $hi")
done

# ---- Config and token ----------------------------------------------------
# Files are rendered to a temp dir and only replace the real ones when they
# differ, so re-running with the same forwards leaves frps (and the players
# connected through it) alone.
changed=0
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
put() {  # put <rendered> <dest> <mode>
    if ! cmp -s "$1" "$2"; then
        info "updating $2"
        install -m "$3" "$1" "$2"
        changed=1
    fi
}
mkdir -p "$ETC"
cat > "$work/frps.toml" <<EOF
# Generated by scripts/vps-relay-setup — re-run it rather than editing.
# Control port: tailnet only, never the public interface.
bindAddr = "$ts_ip"
bindPort = $FRP_PORT

# Player-facing listeners for each forwarded port.
proxyBindAddr = "0.0.0.0"

auth.method = "token"
auth.token = "{{ .Envs.FRP_AUTH_TOKEN }}"
transport.tls.force = true

# Exactly the ports in vps_relay.forwards — frps refuses any others.
allowPorts = [
$allow_ports]

log.to = "console"
EOF
put "$work/frps.toml" "$ETC/frps.toml" 644

new_token=""
if [ -s "$ETC/frps.env" ] && grep -q '^FRP_AUTH_TOKEN=.' "$ETC/frps.env"; then
    info "keeping the existing token in $ETC/frps.env"
else
    info "generating a new token in $ETC/frps.env"
    new_token=$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')
    install -m 600 /dev/null "$ETC/frps.env"
    printf 'FRP_AUTH_TOKEN=%s\n' "$new_token" > "$ETC/frps.env"
    changed=1
fi

# ---- Quadlet -------------------------------------------------------------
mkdir -p "$(dirname "$QUADLET")"
cat > "$work/frps.container" <<EOF
# Generated by scripts/vps-relay-setup — re-run it rather than editing.
[Unit]
Description=frp server (VPS relay)
# frps binds the tailnet IP, so start after Tailscale.
After=tailscaled.service network-online.target
Wants=network-online.target

[Container]
Image=docker.io/fatedier/frps:$FRP_VERSION
Exec=-c /etc/frp/frps.toml
# Host networking so frps can bind the tailnet IP and the public ports.
Network=host
EnvironmentFile=$ETC/frps.env
Volume=$ETC/frps.toml:/etc/frp/frps.toml:ro,Z
# All ports are above 1024, so frps needs no root or capabilities.
User=65534
Group=65534
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL

[Service]
# Retries until the tailnet IP exists if this starts before Tailscale is up.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

put "$work/frps.container" "$QUADLET" 644

if [ "$changed" -eq 1 ] || ! systemctl is-active -q frps; then
    info "pulling frps $FRP_VERSION"
    podman pull -q "docker.io/fatedier/frps:$FRP_VERSION" >/dev/null
    systemctl daemon-reload
    systemctl restart frps
else
    info "configuration unchanged; frps left running"
fi

# ---- Firewall ------------------------------------------------------------
if command -v ufw >/dev/null && ufw status | grep -q '^Status: active'; then
    info "opening ports with ufw"
    for f in "${fw_specs[@]}"; do
        read -r proto lo hi <<<"$f"
        if [ "$lo" = "$hi" ]; then ufw allow "$lo/$proto" >/dev/null
        else ufw allow "$lo:$hi/$proto" >/dev/null; fi
    done
    ufw allow in on tailscale0 to any port "$FRP_PORT" proto tcp >/dev/null
elif command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; then
    info "opening ports with firewalld"
    for f in "${fw_specs[@]}"; do
        read -r proto lo hi <<<"$f"
        firewall-cmd -q --permanent --add-port="$lo-$hi/$proto"
    done
    # The tailnet policy already limits who reaches tailscale0; trusting the
    # interface is what lets the relay reach the control port. change-interface
    # also moves it out of any other zone, and fails loudly rather than leaving
    # the control port unreachable.
    if [ "$(firewall-cmd --get-zone-of-interface=tailscale0 2>/dev/null || true)" != trusted ]; then
        firewall-cmd -q --permanent --zone=trusted --change-interface=tailscale0
    fi
    firewall-cmd -q --reload
else
    echo "WARNING: no active ufw or firewalld. Make sure the forwarded ports are"
    echo "         reachable and $FRP_PORT is NOT open on the public interface."
fi
echo "Reminder: also open the forwarded ports in your VPS provider's cloud firewall, if any."

# ---- Verify --------------------------------------------------------------
info "waiting for frps to listen on $ts_ip:$FRP_PORT"
for _ in $(seq 1 20); do
    ss -ltn | grep -q "$ts_ip:$FRP_PORT " && break
    sleep 1
done
if ss -ltn | grep -q "$ts_ip:$FRP_PORT "; then
    info "frps is up on $ts_ip:$FRP_PORT"
else
    journalctl -u frps -n 20 --no-pager >&2 || true
    die "frps is not listening on $ts_ip:$FRP_PORT (log above)"
fi

if [ -n "$new_token" ]; then
    cat <<EOF

New frp token (also in $ETC/frps.env; reprint with --show-token):

    $new_token

Seal it with the Tailscale OAuth client secret (docs/how-to/vps-relay.md,
"Seal the credentials"), and keep a copy for cluster rebuilds
(VPS_RELAY_FRP_TOKEN).
EOF
fi
