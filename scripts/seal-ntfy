#!/usr/bin/env python3
"""Seal (or re-seal) the ntfy-auth SealedSecret for ntfy.

Usage:
    scripts/seal-ntfy [--rotate USER]...

USER is one of the users in SENDERS (scripts/lib/ntfy_auth.py), or all.

Tokens already in the live ntfy-auth Secret (namespace ntfy) are kept, since
each client holds a copy of its token; any missing, or named with --rotate,
are generated. The password hashes are always regenerated (users
authenticate with tokens only). The result is sealed with kubeseal into
kubernetes-services/additions/ntfy/templates/ntfy-auth-secret.yaml, and each
in-cluster publisher's copy of its token (CLUSTER_COPIES in
scripts/lib/ntfy_auth.py, e.g. alertmanager-ntfy in monitoring) into its own
file. No secret value is printed.

After committing and pushing, and once ArgoCD has synced the new Secret,
recreate the pod (not just its container: the user database is on the
pod's emptyDir, see docs/how-to/ntfy.md):

    kubectl delete pod -n ntfy -l app.kubernetes.io/name=ntfy

then give the owner the new tokens with `just ntfy-tokens`.
"""

from __future__ import annotations

import argparse
import base64
import importlib.util
import json
import os
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
DEST = REPO / "kubernetes-services/additions/ntfy/templates/ntfy-auth-secret.yaml"
NAMESPACE = "ntfy"
NAME = "ntfy-auth"
KUBESEAL = [
    "kubeseal",
    "--controller-name", "sealed-secrets",
    "--controller-namespace", "kube-system",
    "--format", "yaml",
]


def load_ntfy_auth():
    """Import scripts/lib/ntfy_auth.py (scripts/ is not a package)."""
    path = Path(__file__).resolve().parent / "lib" / "ntfy_auth.py"
    spec = importlib.util.spec_from_file_location("ntfy_auth", path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


ntfy_auth = load_ntfy_auth()


def live_data() -> dict[str, str]:
    """The live Secret's data, decoded; empty if it does not exist."""
    res = subprocess.run(
        ["kubectl", "get", "secret", NAME, "-n", NAMESPACE, "-o", "json"],
        capture_output=True,
        text=True,
    )
    if res.returncode != 0:
        if "NotFound" in res.stderr:
            return {}
        sys.exit(f"ERROR: kubectl get secret {NAME} failed: {res.stderr.strip()}")
    raw = json.loads(res.stdout).get("data", {})
    return {k: base64.b64decode(v).decode() for k, v in raw.items()}


def seal(namespace: str, name: str, data: dict[str, str], dest: Path) -> Path | None:
    """Seal a Secret into a temporary file beside `dest`; return its path,
    or None if kubeseal failed."""
    secret = {
        "apiVersion": "v1",
        "kind": "Secret",
        "type": "Opaque",
        "metadata": {"name": name, "namespace": namespace},
        "stringData": data,
    }
    tmp = dest.with_suffix(".yaml.tmp")
    with open(tmp, "w") as out:
        res = subprocess.run(KUBESEAL, input=json.dumps(secret), stdout=out, text=True)
    if res.returncode != 0:
        tmp.unlink(missing_ok=True)
        return None
    return tmp


def main() -> None:
    users = list(ntfy_auth.TOKEN_USERS)
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument(
        "--rotate", action="append", default=[], choices=[*users, "all"],
        help="generate a new token for this user (repeatable)",
    )
    args = parser.parse_args()
    rotate = set(users) if "all" in args.rotate else set(args.rotate)

    live = live_data()
    tokens, kept, generated = {}, [], []
    for user in users:
        token = "" if user in rotate else live.get(f"{user}-token", "")
        if token:
            kept.append(user)
        else:
            token = ntfy_auth.new_token()
            generated.append(user)
        tokens[user] = token

    # Seal every file to a temporary name first, and replace the real files
    # only once all have sealed, so a kubeseal failure leaves no copy out of
    # step with ntfy-auth.
    jobs = [(NAMESPACE, NAME, ntfy_auth.secret_data(tokens), DEST)]
    for user, (namespace, name, path) in ntfy_auth.CLUSTER_COPIES.items():
        jobs.append((namespace, name, {"token": tokens[user]}, REPO / path))
    sealed = []
    for namespace, name, data, dest in jobs:
        tmp = seal(namespace, name, data, dest)
        if tmp is None:
            for _, done in sealed:
                done.unlink(missing_ok=True)
            sys.exit(f"ERROR: kubeseal failed for {name}; no file has changed")
        sealed.append((dest, tmp))
    for dest, tmp in sealed:
        os.replace(tmp, dest)
        print(f"Sealed -> {dest.relative_to(REPO)}")
    if kept:
        print("Kept tokens from the live secret: " + ", ".join(kept))
    if generated:
        print("Generated tokens: " + ", ".join(generated))
        if live:
            print(
                "WARNING: each client holding a replaced token must be given "
                "the new one (`just ntfy-tokens` after the sync).",
                file=sys.stderr,
            )
    print(
        "Next: commit and push; after ArgoCD syncs, recreate the pod:\n"
        f"  kubectl delete pod -n {NAMESPACE} -l app.kubernetes.io/name=ntfy"
    )


if __name__ == "__main__":
    main()
