#!/usr/bin/env python3
"""Generate all cluster secrets fresh for a rebuild.

External credentials (GitHub OAuth, Cloudflare tokens) are read from
environment variables. Everything else (admin passwords, cookie secrets,
Dex client secrets) is generated randomly.

Outputs a JSON file consumed by `scripts/seal-from-json`, or run via the
unified `just generate-and-seal-all` recipe during a rebuild.

Usage:
    scripts/generate-secrets [OUTPUT_DIR]

Required env vars:
    GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET    — Dex GitHub OAuth app
    CLOUDFLARE_API_TOKEN                       — cert-manager DNS solver
    CLOUDFLARE_TUNNEL_TOKEN                    — cloudflared tunnel
    OAUTH2_PROXY_CLIENT_ID                     — oauth2-proxy GitHub OAuth app
    OAUTH2_PROXY_CLIENT_SECRET                 — oauth2-proxy GitHub OAuth app

Optional env vars:
    ADMIN_PASSWORD        — shared admin password (generated if not set)
    SLACK_WEBHOOK_URL     — Alertmanager Slack notification webhook (empty if not set)
    VPS_RELAY_TS_OAUTH_CLIENT_SECRET, VPS_RELAY_FRP_TOKEN
                          — Tailscale OAuth client secret and frp token for the
                            VPS relay (skipped if neither is set; both or none)
    SCRAP_ANTHROPIC_API_KEY
                          — Claude API key for scrap ingest. Set it to seal
                            scrap's secrets (scrap-secrets, and scrap-publish
                            in both scrap and scrap-public); skipped if not set
    SCRAP_MCP_TOKEN       — scrap's /mcp bearer token. Every MCP client holds a
                            copy, so it is kept as given; generated only if not
                            set (a first build)
    SCRAP_ROTATE_MCP_TOKEN
                          — set to "true" to replace SCRAP_MCP_TOKEN with a new
                            one; every MCP client must then be updated
    SCRAP_PUBLISH_TOKEN   — scrap's public-pages upload token, sealed into both
                            namespaces (generated if not set)
    NTFY_<USER>_TOKEN     — ntfy's access token for each user in SENDERS
                            (scripts/lib/ntfy_auth.py), e.g. NTFY_PHONE_TOKEN.
                            Each client holds a copy of its token, so each is
                            kept as given; any not set is generated (a first
                            build, or a rotation: leave it unset)
"""

from __future__ import annotations

import json
import os
import secrets
import importlib.util
import subprocess
import sys
from pathlib import Path


def load_ntfy_auth():
    """Import scripts/lib/ntfy_auth.py (scripts/ is not a package)."""
    path = Path(__file__).resolve().parent / "lib" / "ntfy_auth.py"
    spec = importlib.util.spec_from_file_location("ntfy_auth", path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


ntfy_auth = load_ntfy_auth()

SCRAP_SEALED_SECRET = (
    Path(__file__).resolve().parent.parent
    / "kubernetes-services/additions/scrap/templates/scrap-secret.yaml"
)

REQUIRED_ENV = [
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "CLOUDFLARE_API_TOKEN",
    "CLOUDFLARE_TUNNEL_TOKEN",
    "OAUTH2_PROXY_CLIENT_ID",
    "OAUTH2_PROXY_CLIENT_SECRET",
]


def require_env(name: str) -> str:
    """Get a required environment variable or exit with an error."""
    val = os.environ.get(name, "")
    if not val:
        print(f"ERROR: required environment variable {name} is not set", file=sys.stderr)
        sys.exit(1)
    return val


def write_private(path: Path, text: str) -> None:
    """Write `text` to `path`, created with mode 0600 so it is never readable by others."""
    path.unlink(missing_ok=True)  # O_CREAT keeps an existing file's mode
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(text)


def opt_env(name: str, default: str = "") -> str:
    """Get an optional environment variable with a default."""
    return os.environ.get(name, default)


def random_token(length: int = 32) -> str:
    """Generate a URL-safe random token of exactly `length` characters."""
    return secrets.token_urlsafe(length)[:length]


def random_hex(length: int = 32) -> str:
    """Generate a random hex string of exactly `length` characters."""
    return secrets.token_hex(length // 2 + 1)[:length]


def derive_argocd_client_secret() -> str:
    """Derive the argo-cd Dex client secret by calling the shared script.

    The derivation (base64url(SHA256(server.secretkey))[:40]) lives in
    scripts/derive-argocd-client-secret so it has a single source of truth
    shared with the Ansible and seal-argocd-dex call paths.
    """
    script = Path(__file__).parent / "derive-argocd-client-secret"
    result = subprocess.run([str(script)], capture_output=True, text=True)
    if result.returncode != 0:
        print(
            f"ERROR: derive-argocd-client-secret failed: {result.stderr.strip()}",
            file=sys.stderr,
        )
        sys.exit(1)
    return result.stdout.strip()


def main() -> None:
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return
    output_dir = Path(sys.argv[1]) if len(sys.argv) > 1 else Path("/tmp/cluster-secrets")
    output_dir.mkdir(parents=True, exist_ok=True)

    # Validate required env vars
    missing = [v for v in REQUIRED_ENV if not os.environ.get(v)]
    if missing:
        print("ERROR: missing required environment variables:", file=sys.stderr)
        for v in missing:
            print(f"  {v}", file=sys.stderr)
        sys.exit(1)

    # External credentials
    github_client_id = require_env("GITHUB_CLIENT_ID")
    github_client_secret = require_env("GITHUB_CLIENT_SECRET")
    cloudflare_api_token = require_env("CLOUDFLARE_API_TOKEN")
    cloudflare_tunnel_token = require_env("CLOUDFLARE_TUNNEL_TOKEN")
    oauth2_proxy_client_id = require_env("OAUTH2_PROXY_CLIENT_ID")
    oauth2_proxy_client_secret = require_env("OAUTH2_PROXY_CLIENT_SECRET")

    # Admin password
    admin_password = opt_env("ADMIN_PASSWORD") or random_token(24)

    # ArgoCD argo-cd Dex client secret (derived from live cluster)
    print("Deriving argo-cd client secret from cluster server.secretkey...")
    argocd_client_secret = derive_argocd_client_secret()

    # Generate random Dex static client secrets
    monitor_secret = random_hex(32)
    grafana_secret = random_hex(32)

    # Cookie secrets (exactly 32 bytes for AES)
    monitor_cookie_secret = random_token(32)
    oauth2_proxy_cookie_secret = random_token(32)

    # Build the extracted-secrets.json format
    extracted: list[dict] = []

    # 1. argocd-dex-secret
    extracted.append({
        "namespace": "argo-cd",
        "name": "argocd-dex-secret",
        "data": {
            "dex.github.clientID": github_client_id,
            "dex.github.clientSecret": github_client_secret,
            "argo-cd.clientSecret": argocd_client_secret,
            "argocd.clientSecret": argocd_client_secret,
            "argocd-monitor.clientSecret": monitor_secret,
            "grafana.clientSecret": grafana_secret,
        },
    })

    # 2. argocd-monitor-oauth
    extracted.append({
        "namespace": "argocd-monitor",
        "name": "argocd-monitor-oauth",
        "data": {
            "client-secret": monitor_secret,
            "cookie-secret": monitor_cookie_secret,
        },
    })

    # 3. grafana-oauth-secret
    extracted.append({
        "namespace": "monitoring",
        "name": "grafana-oauth-secret",
        "data": {
            "CLIENT_SECRET": grafana_secret,
        },
    })

    # 4. alertmanager-slack-secret (optional — only included if URL provided)
    slack_webhook_url = opt_env("SLACK_WEBHOOK_URL")
    if slack_webhook_url:
        extracted.append({
            "namespace": "monitoring",
            "name": "alertmanager-slack-secret",
            "data": {
                "webhook-url": slack_webhook_url,
            },
        })

    # 5. cloudflare-api-token
    extracted.append({
        "namespace": "cert-manager",
        "name": "cloudflare-api-token",
        "data": {
            "api-token": cloudflare_api_token,
        },
    })

    # 6. cloudflared-credentials
    extracted.append({
        "namespace": "cloudflared",
        "name": "cloudflared-credentials",
        "data": {
            "TUNNEL_TOKEN": cloudflare_tunnel_token,
        },
    })

    # 6c. vps-relay-credentials (optional — both values or neither)
    ts_oauth_secret = opt_env("VPS_RELAY_TS_OAUTH_CLIENT_SECRET")
    frp_token = opt_env("VPS_RELAY_FRP_TOKEN")
    if bool(ts_oauth_secret) != bool(frp_token):
        print(
            "ERROR: set both VPS_RELAY_TS_OAUTH_CLIENT_SECRET and "
            "VPS_RELAY_FRP_TOKEN, or neither",
            file=sys.stderr,
        )
        sys.exit(1)
    if ts_oauth_secret:
        extracted.append({
            "namespace": "vps-relay",
            "name": "vps-relay-credentials",
            "data": {
                "ts-oauth-client-secret": ts_oauth_secret,
                "frp-token": frp_token,
            },
        })

    # 6d. scrap-secrets and scrap-publish (optional — only with the API key)
    scrap_api_key = opt_env("SCRAP_ANTHROPIC_API_KEY")
    scrap_mcp_token = opt_env("SCRAP_MCP_TOKEN")
    scrap_publish_token = opt_env("SCRAP_PUBLISH_TOKEN")
    rotate_mcp = opt_env("SCRAP_ROTATE_MCP_TOKEN").lower() == "true"
    scrap_mcp_token_file: Path | None = None
    # The token file exists only when this run generated a new token, so a
    # stale one from an earlier run must not survive.
    (output_dir / "scrap-mcp-token.txt").unlink(missing_ok=True)
    if not scrap_api_key and (scrap_mcp_token or scrap_publish_token or rotate_mcp):
        print(
            "ERROR: SCRAP_MCP_TOKEN, SCRAP_PUBLISH_TOKEN or SCRAP_ROTATE_MCP_TOKEN "
            "is set but SCRAP_ANTHROPIC_API_KEY is not; scrap's secrets would be "
            "skipped. Set SCRAP_ANTHROPIC_API_KEY too, or none of them",
            file=sys.stderr,
        )
        sys.exit(1)
    if not scrap_api_key and SCRAP_SEALED_SECRET.exists():
        print(
            f"WARNING: {SCRAP_SEALED_SECRET} exists but SCRAP_ANTHROPIC_API_KEY "
            "is not set; scrap's secrets will not be resealed and scrap will "
            "not start on the new cluster",
            file=sys.stderr,
        )
    if scrap_api_key:
        if rotate_mcp or not scrap_mcp_token:
            # A new token: write it to a file for the MCP clients, never print it.
            scrap_mcp_token = random_token(48)
            scrap_mcp_token_file = output_dir / "scrap-mcp-token.txt"
            write_private(scrap_mcp_token_file, scrap_mcp_token + "\n")
        if not scrap_publish_token:
            scrap_publish_token = random_token(48)
        extracted.append({
            "namespace": "scrap",
            "name": "scrap-secrets",
            "data": {
                "ANTHROPIC_API_KEY": scrap_api_key,
                "SCRAP_MCP_TOKEN": scrap_mcp_token,
            },
        })
        # One token, sealed into each namespace (a pod reads only its own).
        for ns in ("scrap", "scrap-public"):
            extracted.append({
                "namespace": ns,
                "name": "scrap-publish",
                "data": {
                    "token": scrap_publish_token,
                },
            })

    # 6e. ntfy-auth: keep the exported tokens (clients hold copies),
    # generate any that are missing.
    ntfy_generated = []
    ntfy_tokens = {}
    for user in ntfy_auth.TOKEN_USERS:
        token = opt_env(ntfy_auth.env_name(user))
        if not token:
            token = ntfy_auth.new_token()
            ntfy_generated.append(user)
        ntfy_tokens[user] = token
    try:
        ntfy_data = ntfy_auth.secret_data(ntfy_tokens)
    except ValueError as e:
        print(f"ERROR: {e}", file=sys.stderr)
        sys.exit(1)
    extracted.append({
        "namespace": "ntfy",
        "name": "ntfy-auth",
        "data": ntfy_data,
    })

    # 7. oauth2-proxy-credentials
    extracted.append({
        "namespace": "oauth2-proxy",
        "name": "oauth2-proxy-credentials",
        "data": {
            "client-id": oauth2_proxy_client_id,
            "client-secret": oauth2_proxy_client_secret,
            "cookie-secret": oauth2_proxy_cookie_secret,
        },
    })

    # Write JSON
    dest = output_dir / "generated-secrets.json"
    write_private(dest, json.dumps(extracted, indent=2) + "\n")
    print(f"Wrote {dest} ({len(extracted)} secrets)")

    # Write admin password to a separate file for easy retrieval
    admin_file = output_dir / "admin-password.txt"
    write_private(admin_file, admin_password + "\n")
    print(f"Wrote {admin_file}")
    print(f"\nAdmin password: {admin_password}")

    if ntfy_generated:
        print(
            "\nWARNING: generated new ntfy tokens (" + ", ".join(ntfy_generated)
            + "). Each client holding an old one must be given the new one: "
            "`just ntfy-tokens` once ntfy-auth syncs.",
            file=sys.stderr,
        )

    if scrap_mcp_token_file:
        reason = "rotated on request" if rotate_mcp else "none was given"
        print(
            f"\nWARNING: generated a new SCRAP_MCP_TOKEN ({reason}), saved to "
            f"{scrap_mcp_token_file}.\nEvery scrap MCP client must be updated "
            "with it once the new SealedSecret syncs.",
            file=sys.stderr,
        )


if __name__ == "__main__":
    main()
