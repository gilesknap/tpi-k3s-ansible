{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "assignees": [
    "gilesknap"
  ],
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10,
  "enabledManagers": [
    "kubernetes",
    "argocd",
    "gomod",
    "custom.regex",
    "kustomize"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "kubernetes": {
    "fileMatch": [
      "^kubernetes-services/.*\\.yaml$",
      "(^|/)kustomization\\.ya?ml$"
    ]
  },
  "argocd": {
    "fileMatch": [
      "^kubernetes-services/templates/.*\\.yaml$"
    ]
  },
  "packageRules": [
    {
      "description": "vendored upstream manifests: upgrade by re-vendoring the files, as their kustomization.yaml header describes",
      "matchFileNames": [
        "kubernetes-services/additions/system-upgrade-controller/crd.yaml",
        "kubernetes-services/additions/system-upgrade-controller/system-upgrade-controller.yaml",
        "kubernetes-services/additions/intel-gpu-plugin/upstream/**"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "argocd"
      ],
      "enabled": true,
      "automerge": true,
      "labels": [
        "argocd",
        "helm chart"
      ]
    },
    {
      "description": "Cilium is the cluster's CNI: a bump restarts the agent on every node, so it is never automerged; read the upgrade notes before a minor bump (kubernetes-services/templates/cilium.yaml)",
      "matchManagers": [
        "argocd"
      ],
      "matchPackageNames": [
        "cilium"
      ],
      "automerge": false,
      "labels": [
        "argocd",
        "helm chart",
        "cilium"
      ]
    },
    {
      "description": "Gateway API CRDs: the version must be one the running Cilium supports (kubernetes-services/additions/gateway-api-crds/kustomization.yaml), so never automerged",
      "matchManagers": [
        "kustomize"
      ],
      "matchPackageNames": [
        "kubernetes-sigs/gateway-api"
      ],
      "automerge": false,
      "labels": [
        "gateway-api"
      ]
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "enabled": true,
      "automerge": true,
      "labels": [
        "golang"
      ]
    },
    {
      "description": "respect weird docker versioning",
      "versioning": "docker",
      "matchDatasources": [
        "docker"
      ],
      "labels": [
        "container image"
      ]
    },
    {
      "description": "grouping of istio helm charts",
      "groupName": "istio helm charts",
      "matchPackageNames": [
        "istiod",
        "gateway",
        "base"
      ],
      "labels": [
        "argocd",
        "helm chart",
        "istio"
      ]
    },
    {
      "description": "grouping of monitoring helm charts",
      "groupName": "monitoring helm charts",
      "matchPackageNames": [
        "kube-prometheus-stack",
        "loki-stack"
      ],
      "labels": [
        "argocd",
        "helm chart",
        "monitoring"
      ]
    },
    {
      "description": "grouping of k8s packages",
      "groupName": "go k8s apis",
      "matchDatasources": "go",
      "matchPackageNames": [
        "k8s.io/**",
        "sigs.k8s.io/**"
      ],
      "labels": [
        "golang",
        "k8s api",
        "e2e framework"
      ]
    },
    {
      "description": "Grouping of Alpine and Cloudflare OCI artifacts",
      "groupName": "cloudflare",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "alpine",
        "cloudflare/cloudflared"
      ],
      "labels": [
        "oci artifacts"
      ]
    }
  ]
}
