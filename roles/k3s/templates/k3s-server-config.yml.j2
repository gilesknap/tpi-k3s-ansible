disable:
  - traefik
# Cilium is the CNI, the NetworkPolicy engine and the kube-proxy replacement
# (ADR 0015, kubernetes-services/templates/cilium.yaml), so k3s runs no
# flannel, no policy controller and no kube-proxy. Agents take all three
# settings from the server. Changing them on a running cluster cuts pod
# networking, so control.yml refuses to; the move is done by a rebuild.
# servicelb stays enabled: it gives Cilium's Gateway its node IPs.
flannel-backend: none
disable-network-policy: true
disable-kube-proxy: true
cluster-init: true
# Extra name in the API server certificate, so agents and kubectl can reach
# the API through k3s_api_name. k3s adds the node's hostname and IPs itself.
tls-san:
  - {{ k3s_api_name }}
# Serve etcd's /metrics on the node's address as well as 127.0.0.1 (port
# 2381, plain HTTP, metrics only), so Prometheus can scrape it: kubeEtcd in
# kubernetes-services/templates/grafana.yaml.
etcd-expose-metrics: true
