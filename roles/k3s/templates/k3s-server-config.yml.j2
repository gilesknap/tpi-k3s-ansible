disable:
  - traefik
cluster-init: true
# Extra name in the API server certificate, so agents and kubectl can reach
# the API through k3s_api_name. k3s adds the node's hostname and IPs itself.
tls-san:
  - {{ k3s_api_name }}
# Serve etcd's /metrics on the node's address as well as 127.0.0.1 (port
# 2381, plain HTTP, metrics only), so Prometheus can scrape it: kubeEtcd in
# kubernetes-services/templates/grafana.yaml.
etcd-expose-metrics: true
