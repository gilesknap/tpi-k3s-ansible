// Managed by Ansible (roles/update_packages).
// Ubuntu's default only installs the -security pocket. Also install
// -updates, where kernel and other bug-fix releases land. Lists in apt.conf
// files add to each other, so this extends 50unattended-upgrades.
Unattended-Upgrade::Allowed-Origins {
    "${distro_id}:${distro_codename}-updates";
};
// kured reboots the node inside the cluster's reboot window.
Unattended-Upgrade::Automatic-Reboot "false";
