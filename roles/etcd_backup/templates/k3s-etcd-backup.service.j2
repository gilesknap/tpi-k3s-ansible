# {{ ansible_managed }}
[Unit]
Description=Encrypted off-node backup of the k3s etcd snapshot, token and sealed-secrets keys
Wants=network-online.target
After=network-online.target k3s.service

[Service]
Type=oneshot
# The lock keeps this job and router-backup from sharing (and one of
# them unmounting) the NAS mount, e.g. when both timers catch up at boot.
ExecStart=/usr/bin/flock /run/k3s-backup-nas.lock /usr/local/sbin/k3s-etcd-backup
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
