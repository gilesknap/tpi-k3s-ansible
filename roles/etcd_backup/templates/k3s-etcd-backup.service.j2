# {{ ansible_managed }}
[Unit]
Description=Encrypted off-node backup of the k3s etcd snapshot, token and sealed-secrets keys
Wants=network-online.target
After=network-online.target k3s.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/k3s-etcd-backup
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
