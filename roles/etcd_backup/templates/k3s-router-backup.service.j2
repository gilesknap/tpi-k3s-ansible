# {{ ansible_managed }}
[Unit]
Description=Encrypted backup of the OpenWrt router's configuration
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# The lock keeps this job and k3s-etcd-backup from sharing (and one of
# them unmounting) the NAS mount, e.g. when both timers catch up at boot.
ExecStart=/usr/bin/flock /run/k3s-backup-nas.lock /usr/local/sbin/k3s-router-backup
Nice=10
TimeoutStartSec=10min
