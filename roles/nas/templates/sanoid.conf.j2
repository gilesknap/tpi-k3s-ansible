# {{ ansible_managed }} (roles/nas).
# Snapshots of the main pool, and pruning of the copies on the backup pool.
# sanoid.timer runs `sanoid --cron` every 15 minutes.

[{{ nas_pool }}]
	use_template = production
	recursive = yes
	process_children_only = yes

{% if nas_pools_present[nas_backup_pool] | default(false) %}
[{{ nas_backup_pool }}/{{ nas_pool }}]
	use_template = backup
	recursive = yes
{% endif %}

[template_production]
	frequently = 0
	hourly = {{ nas_snapshot_retention.hourly }}
	daily = {{ nas_snapshot_retention.daily }}
	weekly = {{ nas_snapshot_retention.weekly }}
	monthly = {{ nas_snapshot_retention.monthly }}
	yearly = 0
	# sanoid's defaults, stated because nas_hold_on_calendar follows them:
	# the weekly is taken on Mondays at 23:30 (local time), or at the first
	# sanoid.timer run after it.
	weekly_wday = 1
	weekly_hour = 23
	weekly_min = 30
	autosnap = yes
	autoprune = yes

# The copies: never snapshotted here (they arrive by zfs receive), only
# pruned. syncoid keeps its own newest snapshot on both sides, so the next
# night's copy is incremental whatever sanoid prunes.
[template_backup]
	frequently = 0
	hourly = {{ nas_backup_retention.hourly }}
	daily = {{ nas_backup_retention.daily }}
	weekly = {{ nas_backup_retention.weekly }}
	monthly = {{ nas_backup_retention.monthly }}
	yearly = 0
	autosnap = no
	autoprune = yes
