#!/bin/bash
# {{ ansible_managed }} (roles/nas).
# Copy every dataset of {{ nas_pool }} to {{ nas_backup_pool }}/{{ nas_pool }}
# with syncoid (zfs send | zfs receive; incremental after the first run).
# The received datasets are read-only, mounted under
# {{ nas_backup_pool_mountpoint }}. The pool's root and $dst are not
# mounted: read-only, they could not hold their children's mount points.
# Writes the time of the last success for node-exporter's textfile
# collector.
set -euo pipefail

src={{ nas_pool }}
dst={{ nas_backup_pool }}/{{ nas_pool }}
prom={{ nas_textfile_dir }}/nas_replicate.prom

metric() {
    local tmp
    tmp=$(mktemp "$prom.XXXXXX")
    {
        echo "# HELP nas_replicate_last_run_timestamp_seconds When the copy to the backup pool last finished."
        echo "# TYPE nas_replicate_last_run_timestamp_seconds gauge"
        echo "nas_replicate_last_run_timestamp_seconds $(date +%s)"
        echo "# HELP nas_replicate_last_run_success 1 if the last copy to the backup pool succeeded."
        echo "# TYPE nas_replicate_last_run_success gauge"
        echo "nas_replicate_last_run_success $1"
        if [ "$1" = 1 ]; then
            echo "# HELP nas_replicate_last_success_timestamp_seconds When the copy to the backup pool last succeeded."
            echo "# TYPE nas_replicate_last_success_timestamp_seconds gauge"
            echo "nas_replicate_last_success_timestamp_seconds $(date +%s)"
        elif [ -f "$prom" ]; then
            grep '^nas_replicate_last_success_timestamp_seconds' "$prom" || true
        fi
    } >"$tmp"
    chmod 0644 "$tmp"
    mv "$tmp" "$prom"
}
trap 'metric 0' ERR

if ! zpool list -H -o name "{{ nas_backup_pool }}" >/dev/null 2>&1; then
    echo "pool {{ nas_backup_pool }} is not imported (is the LaCie plugged in?)" >&2
    metric 0
    exit 1
fi

rc=0
syncoid --recursive --identifier={{ nas_backup_pool }} "$src" "$dst" || rc=$?
# The first receive creates $dst mountable (canmount is not sent), so its
# children then fail to mount and syncoid fails; like $src's root it holds
# no files.
if zfs list -H "$dst" >/dev/null 2>&1 \
    && [ "$(zfs get -H -o value canmount "$dst")" != off ]; then
    zfs set canmount=off "$dst"
    zfs mount -a
fi
if [ "$rc" != 0 ]; then
    metric 0
    exit "$rc"
fi
metric 1
