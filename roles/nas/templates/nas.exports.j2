# {{ ansible_managed }} (roles/nas).
# The cluster's NFS shares: only to the nodes and ws03, each export to the
# hosts in its `clients` (default: all), read-only to its `read_only_for`.
# Clients mount the real paths (e.g. 192.168.1.3:/bigdisk/k8s-cluster),
# over NFS 4.1. Each ZFS dataset is exported on its own.
{% for e in nas_nfs_exports %}
{%   set names = e.clients | default(nas_nfs_clients) %}
{%   set hosts = nas_nfs_clients | select('in', names) | select('in', groups['all']) | list %}
{%   if hosts %}

{{ e.path }} \
{%     for c in hosts %}
{%       set opts = e.options | regex_replace('(^|,)rw(,|$)', '\\1ro\\2') if c in e.read_only_for | default([]) else e.options %}
    {{ hostvars[c].lan_ip }}({{ opts }}){{ ' \\' if not loop.last else '' }}
{%     endfor %}
{%   endif %}
{% endfor %}
