# {{ ansible_managed }} (roles/nas).
# The cluster's NFS shares: read-write only to the nodes and ws03.
# Clients mount the real paths (e.g. 192.168.1.3:/bigdisk/k8s-cluster),
# over NFS 4.1. Each ZFS dataset is exported on its own.
{% for e in nas_nfs_exports %}

{{ e.path }} \
{% for c in nas_nfs_clients %}
    {{ c.ip }}({{ e.options }}){{ ' \\' if not loop.last else '' }}
{% endfor %}
{% endfor %}
