# Managed by Ansible (rk1_os).
# Turing RK1 (RK3588) booted via U-Boot EFI -> GRUB. root= is added by GRUB.
GRUB_TIMEOUT_STYLE=menu
GRUB_TIMEOUT={{ rk1_os_grub_timeout }}
GRUB_CMDLINE_LINUX_DEFAULT=""
GRUB_CMDLINE_LINUX="{{ rk1_os_cmdline }}"
# U-Boot's EFI text console already goes to the UART (ttyS9); GRUB has no
# EFI serial device here, so "serial" only produces errors.
GRUB_TERMINAL=console
GRUB_DISABLE_OS_PROBER=true
