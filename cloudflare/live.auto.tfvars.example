# Copy to live.auto.tfvars (gitignored) and fill in. OpenTofu loads
# *.auto.tfvars automatically. The values here are placeholders.

account_id       = "0123456789abcdef0123456789abcdef"
zone_id          = "fedcba9876543210fedcba9876543210"
domain           = "example.com"
tunnel_name      = "mycluster"

owner_emails         = ["owner@example.com"]
viewer_emails        = ["friend@example.net"]
viewer_email_domains = ["example.org"]

# Name of the login method (set up in the dashboard) the Owner policy requires.
# owner_login_method = "GitHub"

# Records that are not tunnel routes, keyed by name below the domain.
# home-lan and home-tailnet are the home page's network probes: point them
# at the LAN IP and the tailnet IP of a node that runs the ingress
# LoadBalancer's ServiceLB pod (a worker, not a tainted control plane).
# Leave out home-tailnet if you don't use Tailscale.
dns_only_records = {
  home-lan     = { type = "A", content = "192.168.1.10" } # LAN-only ingress name
  home-tailnet = { type = "A", content = "100.64.0.10" }  # tailnet ingress name
  mc           = { type = "A", content = "203.0.113.10" } # VPS relay
}

# IDs of the objects that already exist, for the import blocks in
# imports.tf. Leave out anything that does not exist yet: it is created.
# docs/how-to/cloudflare-as-code.md shows the API calls that list them.
import_ids = {
  tunnel = "00000000-0000-0000-0000-000000000000"
  dns_records = {
    # <name below the domain> = <DNS record ID>
    argocd   = "0123456789abcdef0123456789abcdef"
    home-lan = "123456789abcdef0123456789abcdef0"
  }
  access_apps = {
    # keys: clusterapps, demo, pages, scrap, ntfy (local.access_apps in access.tf)
    clusterapps = "00000000-0000-0000-0000-000000000000"
  }
  access_policies = {
    # keys: owner, viewers, bypass, scrap_mcp
    owner = "00000000-0000-0000-0000-000000000000"
  }
  cache_ruleset = "0123456789abcdef0123456789abcdef"
}

# Refs of existing cache rules, keyed by service name, so that imported
# rules keep their IDs (the rule's "ref" in the ruleset API).
cache_rule_refs = {
  pages = "0123456789abcdef0123456789abcdef"
}
